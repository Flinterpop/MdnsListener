#include <winver.h>
#include "version.h"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION MDNSL_VERSION_NUM
 PRODUCTVERSION MDNSL_VERSION_NUM
 FILEFLAGSMASK 0x3FL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "MDNS Listener - passive mDNS log and decoder"
            VALUE "FileVersion", MDNSL_VERSION_STR
            VALUE "ProductName", "MDNS Listener"
            VALUE "ProductVersion", MDNSL_VERSION_STR
            VALUE "OriginalFilename", "MdnsListener.exe"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
